# API Configuration (Same for dev and production)
VITE_API_BASE_URL=/api

# Backend Email Server Configuration (Local development only)
PORT=5000
FRONTEND_URLS=http://localhost:3000,http://localhost:5173

# Email Service (Gmail SMTP)
# ⚠️ IMPORTANT: Use Gmail App Password, NOT your regular Gmail password
# 
# How to get Gmail App Password:
# 1. Enable 2-Step Verification: https://myaccount.google.com/security
# 2. Go to "App Passwords" section
# 3. Select "Mail" + "Windows Computer" (or your device)
# 4. Google generates a 16-character password
# 5. Copy it below (includes spaces; remove them if pasting)
#
# For local development (npm run dev:full):
#   Set both EMAIL_USER and EMAIL_PASS below
#
# For Vercel production (vercel.com):
#   Set EMAIL_USER and EMAIL_PASS via Vercel Dashboard:
#   Project Settings → Environment Variables → New Variable
#
EMAIL_USER=your_gmail_address@gmail.com
EMAIL_PASS=aaaa bbbb cccc dddd
